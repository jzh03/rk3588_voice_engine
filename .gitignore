# Build output, recordings, and temporary checks
/build/
/output/
/tmp/
/env-check-*/
/tools/env_check
__pycache__/
*.py[cod]

# Local configuration and credentials
/config/local.yaml
/config/realtime-local.yaml
/config/wake-local.yaml
/config/barge-in-local.yaml
.env
.env.*
!.env.example
*.pem
*.key

# Model and runtime files; track manifests and directory placeholders only
/models/*
!/models/.gitkeep
!/models/manifest.json
!/models/pronunciation-candidates.json
/deps/*
!/deps/.gitkeep
!/deps/manifest.json

# Private experiment records and reviews; keep files on the board.
# Keep these files locally; remove tracked entries with git rm --cached only.
# Ignore rules do not remove files from existing commits or remote history.

# records
/EXECUTION_PLAN.md
/MIGRATION_GUIDE.md
/docs/environment.md
/docs/ACCEPTANCE.md
/docs/PLAN_REVIEW.md
/docs/model-prep-*.md
/docs/tts-parallel-experiment.md
/docs/output-layout.md
/docs/archive/
/docs/evidence/*
!/docs/evidence/sdk/
# Approved compact snapshot; keep all other experiment records private.
!/docs/evidence/performance-snapshot-20261027.json

# mixed
/doc/voicenpu-reference-review.md
/docs/file-fixtures.md
/docs/asr-probe.md
/docs/llm-probe.md
/docs/tts-probe.md
/docs/coexist-probe.md
/docs/voice-file-demo.md
/docs/realtime-engine.md
/docs/wake-dialogue.md
/docs/barge-in.md
/docs/compatibility.md
/docs/deployment.md
/docs/reference/

# summaries
/tests/fixtures/*-review.json
/tests/fixtures/*-acceptance.json
/tests/fixtures/*-scope*.json
/tests/fixtures/realtime-engine-implementation.json
/tests/fixtures/natural-corpus.json
