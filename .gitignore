# Build output, recordings, and temporary checks
/build/
/output/
/tmp/
/env-check-*/
/tools/env_check
__pycache__/
*.py[cod]

# Local configuration and credentials
/config/local.yaml
.env
.env.*
!.env.example
*.pem
*.key

# Model and runtime files; track manifests and directory placeholders only
/models/*
!/models/.gitkeep
!/models/manifest.json
/deps/*
!/deps/.gitkeep
!/deps/manifest.json
