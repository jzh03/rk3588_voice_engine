# Optional file diagnostic: no model/runtime dependency in default builds.
find_package(PkgConfig REQUIRED)
find_package(nlohmann_json CONFIG REQUIRED)
find_package(Threads REQUIRED)
pkg_check_modules(ASR_SNDFILE REQUIRED IMPORTED_TARGET sndfile)
set(_asr_root "${PROJECT_SOURCE_DIR}/deps/model-prep/asr/upstream")
set(_asr_rknn "${PROJECT_SOURCE_DIR}/deps/rknn-2.3.2")
set(_asr_speech "${PROJECT_SOURCE_DIR}/deps/model-prep/speech")
set(_asr_sherpa_lib "${_asr_speech}/sherpa-onnx-v1.12.14-linux-aarch64-shared-cpu/lib")
set(_asr_fbank "${_asr_root}/3rdparty/kaldi_native_fbank/Linux/aarch64/libkaldi-native-fbank-core.a")
foreach(_file IN ITEMS "${_asr_fbank}" "${_asr_rknn}/include/rknn_api.h" "${_asr_rknn}/lib/librknnrt.so" "${_asr_sherpa_lib}/libsherpa-onnx-c-api.so")
    if(NOT EXISTS "${_file}")
        message(FATAL_ERROR "ASR probe requires fixed private dependency: ${_file}")
    endif()
endforeach()
add_library(voice_engine_asr STATIC src/asr/zipformer.cpp src/asr/silero_vad.cpp)
voice_engine_cpp_target(voice_engine_asr)
target_include_directories(voice_engine_asr PUBLIC include PRIVATE "${_asr_rknn}/include" "${_asr_root}/3rdparty/kaldi_native_fbank/include" "${_asr_speech}/include" "${_asr_speech}/onnxruntime/onnxruntime-linux-aarch64-glibc2_17-Release-1.17.1-patched/include")
target_link_libraries(voice_engine_asr PUBLIC voice_engine_config PRIVATE voice_engine_probe_support nlohmann_json::nlohmann_json "${_asr_fbank}" "${_asr_rknn}/lib/librknnrt.so" "${_asr_sherpa_lib}/libsherpa-onnx-c-api.so" "${_asr_sherpa_lib}/libonnxruntime.so" Threads::Threads m)
# Fixed upstream fbank static archive was built without PIC; consumers must use
# non-PIE executables. Do not silently rebuild/replace this fixed dependency.
target_link_options(voice_engine_asr INTERFACE -no-pie)
add_executable(asr_probe tools/asr_probe.cpp)
voice_engine_cpp_target(asr_probe)
target_link_libraries(asr_probe PRIVATE voice_engine_asr voice_engine_assets voice_engine_probe_support nlohmann_json::nlohmann_json PkgConfig::ASR_SNDFILE)
set_target_properties(asr_probe PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin" BUILD_RPATH "${_asr_rknn}/lib;${_asr_sherpa_lib}")
if(BUILD_TESTING)
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    add_executable(vad_window_test tests/unit/vad_window_test.cpp)
    voice_engine_cpp_target(vad_window_test)
    target_include_directories(vad_window_test PRIVATE include)
    add_test(NAME vad_window COMMAND vad_window_test)
    add_executable(asr_metrics_test tests/unit/asr_metrics_test.cpp)
    voice_engine_cpp_target(asr_metrics_test)
    add_test(NAME asr_metrics COMMAND asr_metrics_test)
    add_test(NAME asr_probe_cli COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tests/integration/asr_probe.py" "$<TARGET_FILE:asr_probe>")
    set_tests_properties(vad_window asr_probe_cli PROPERTIES TIMEOUT 30)
endif()
