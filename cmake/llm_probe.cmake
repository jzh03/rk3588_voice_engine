# Explicit opt-in only: fixed private runtime is never queried by default builds.
if(NOT TARGET voice_engine_assets OR NOT TARGET voice_engine_probe_support)
    message(FATAL_ERROR "LLM probe requires ENGINE and probe support")
endif()
find_package(Threads REQUIRED)
find_package(nlohmann_json CONFIG REQUIRED)
set(_llm_sdk "${PROJECT_SOURCE_DIR}/deps/rkllm-1.3.0")
foreach(_f IN ITEMS "${_llm_sdk}/include/rkllm.h" "${_llm_sdk}/lib/librkllmrt.so")
    if(NOT EXISTS "${_f}")
        message(FATAL_ERROR "LLM fixed private dependency is missing: ${_f}")
    endif()
endforeach()
add_library(voice_engine_llm_core STATIC src/llm/adapter.cpp)
voice_engine_cpp_target(voice_engine_llm_core)
target_include_directories(voice_engine_llm_core PUBLIC include)
target_link_libraries(voice_engine_llm_core PUBLIC Threads::Threads)
add_library(voice_engine_llm STATIC src/llm/rkllm.cpp)
voice_engine_cpp_target(voice_engine_llm)
target_include_directories(voice_engine_llm PRIVATE "${_llm_sdk}/include")
target_link_libraries(voice_engine_llm PUBLIC voice_engine_llm_core voice_engine_assets
    PRIVATE voice_engine_probe_support nlohmann_json::nlohmann_json "${_llm_sdk}/lib/librkllmrt.so")
add_executable(llm_probe tools/llm_probe.cpp)
voice_engine_cpp_target(llm_probe)
target_link_libraries(llm_probe PRIVATE voice_engine_llm voice_engine_probe_support nlohmann_json::nlohmann_json)
set_target_properties(llm_probe PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin"
    BUILD_RPATH "${_llm_sdk}/lib")
if(BUILD_TESTING)
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    add_executable(llm_adapter_test tests/unit/llm_adapter_test.cpp)
    voice_engine_cpp_target(llm_adapter_test)
    target_link_libraries(llm_adapter_test PRIVATE voice_engine_llm_core)
    add_test(NAME llm_adapter COMMAND llm_adapter_test)
    set_tests_properties(llm_adapter PROPERTIES TIMEOUT 30)
    add_test(NAME llm_probe_cli COMMAND "${Python3_EXECUTABLE}"
        "${PROJECT_SOURCE_DIR}/tests/integration/llm_probe.py" "$<TARGET_FILE:llm_probe>")
    set_tests_properties(llm_probe_cli PROPERTIES TIMEOUT 30)
endif()
