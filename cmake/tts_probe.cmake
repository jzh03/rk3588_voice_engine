# Included only for the explicit opt-in; normal build boundaries stay unchanged.
if(NOT TARGET voice_engine_assets OR NOT TARGET voice_engine_audio_dsp OR NOT TARGET voice_engine_probe_support)
    message(FATAL_ERROR "TTS probe requires ENGINE, AUDIO, PULSE_AUDIO and probe support")
endif()
set(_tts_base "${CMAKE_CURRENT_SOURCE_DIR}/deps/model-prep/speech")
set(_tts_lib "${_tts_base}/sherpa-onnx-v1.12.14-linux-aarch64-shared-cpu/lib")
set(_tts_ort "${_tts_base}/onnxruntime/onnxruntime-linux-aarch64-glibc2_17-Release-1.17.1-patched/include")
foreach(_f IN ITEMS "${_tts_base}/include/sherpa-onnx/c-api/c-api.h" "${_tts_ort}/onnxruntime_c_api.h" "${_tts_lib}/libsherpa-onnx-c-api.so" "${_tts_lib}/libonnxruntime.so")
    if(NOT EXISTS "${_f}")
        message(FATAL_ERROR "TTS fixed private dependency is missing: ${_f}")
    endif()
endforeach()
add_library(voice_engine_tts_text STATIC src/tts/text.cpp)
voice_engine_cpp_target(voice_engine_tts_text)
target_link_libraries(voice_engine_tts_text PUBLIC voice_engine_audio_dsp)
add_library(voice_engine_tts STATIC src/tts/melo.cpp)
voice_engine_cpp_target(voice_engine_tts)
target_include_directories(voice_engine_tts PRIVATE "${_tts_base}/include" "${_tts_ort}")
target_link_libraries(voice_engine_tts PUBLIC voice_engine_tts_text voice_engine_assets PRIVATE voice_engine_probe_support nlohmann_json::nlohmann_json "${_tts_lib}/libsherpa-onnx-c-api.so" "${_tts_lib}/libonnxruntime.so")
pkg_check_modules(TTS_SNDFILE REQUIRED IMPORTED_TARGET sndfile)
add_executable(tts_probe tools/tts_probe.cpp)
voice_engine_cpp_target(tts_probe)
target_link_libraries(tts_probe PRIVATE voice_engine_tts voice_engine_probe_support nlohmann_json::nlohmann_json PkgConfig::TTS_SNDFILE)
set_target_properties(tts_probe PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin" BUILD_RPATH "${_tts_lib}")
if(BUILD_TESTING)
    add_executable(tts_text_test tests/unit/tts_text_test.cpp)
    voice_engine_cpp_target(tts_text_test)
    target_link_libraries(tts_text_test PRIVATE voice_engine_tts_text)
    add_test(NAME tts_text COMMAND tts_text_test)
    set_tests_properties(tts_text PROPERTIES TIMEOUT 30)
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    add_test(NAME tts_probe_cli COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/integration/tts_probe.py" "$<TARGET_FILE:tts_probe>")
    set_tests_properties(tts_probe_cli PROPERTIES TIMEOUT 60)
endif()
